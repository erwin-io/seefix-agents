# ============================================================
# SEEFIX Agent Service - example configuration
# Copy to .env and replace placeholders. Never commit .env.
# ============================================================

SEEFIX_OLLAMA_BASE_URL=http://127.0.0.1:11434
SEEFIX_OLLAMA_MODEL=qwen3-vl:2b-instruct-q4_K_M
SEEFIX_REQUEST_TIMEOUT_SECONDS=180
SEEFIX_MAX_UPLOAD_MB=10
SEEFIX_MAX_IMAGE_DIMENSION=512
SEEFIX_MODEL_CONTEXT=2048
SEEFIX_MODEL_MAX_OUTPUT_TOKENS=768
SEEFIX_MODEL_KEEP_ALIVE=15m
DATABASE_URL=postgresql://postgres:admin123@127.0.0.1:5432/seefixdb

SEEFIX_DATABASE_SSLMODE=prefer
SEEFIX_DATABASE_SSLROOTCERT=
SEEFIX_DATABASE_CONNECT_TIMEOUT_SECONDS=10
SEEFIX_DATABASE_APPLICATION_NAME=seefix-agents

SEEFIX_AGENT_WORKER_NAME=seefix-agent-01
SEEFIX_AGENT_POLL_SECONDS=3
SEEFIX_AGENT_STALE_MINUTES=30

SEEFIX_COMPLETION_WORKER_NAME=seefix-completion-agent-01
SEEFIX_COMPLETION_POLL_SECONDS=3
SEEFIX_COMPLETION_STALE_MINUTES=30

SEEFIX_RECURRENCE_THRESHOLD=2
SEEFIX_RECURRENCE_LOOKBACK_DAYS=365
SEEFIX_VERIFICATION_THRESHOLD=2
SEEFIX_DUPLICATE_LOOKBACK_DAYS=30

SEEFIX_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
SEEFIX_ALLOWED_IMAGE_HOSTS=res.cloudinary.com
SEEFIX_IMAGE_MAX_REDIRECTS=3

SEEFIX_WORKFLOW_MONITOR_ENABLED=true
SEEFIX_WORKFLOW_MONITOR_SECONDS=60
SEEFIX_PROCUREMENT_EXPECTED_DAYS=3
SEEFIX_PROCUREMENT_FOLLOWUP_HOURS=24

SEEFIX_REQUIRE_API_KEY=true
SEEFIX_AGENT_API_KEY=PWUdScknn7Bx15mAB1golRjYtrQszbnmu7d6Oexjpxzkj_MzXPVy070Ac7eqmSNw
